{
  "name": "marcobroker",
  "version": "0.1.0",
  "description": "Agente de notícias da Bolsa BR — monitora fontes, classifica via LLM, envia alertas para Discord/Telegram",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "once": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.2",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "iconv-lite": "^0.7.3",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rss-parser": "^3.13.0",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.2": true,
    "esbuild@0.28.1": true
  }
}
